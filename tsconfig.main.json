  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist/main",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true
  },
  "include": ["src/main/**/*"]
}
